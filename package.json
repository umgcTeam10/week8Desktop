{
  "name": "careconnect-desktop",
  "version": "1.0.0",
  "description": "CareConnect Week 8 Desktop Application",
  "main": "dist/main/main.js",
  "author": "CareConnect",
  "license": "MIT",
  "homepage": ".",
  "scripts": {
    "build": "tsc -p tsconfig.electron.json && react-scripts build",
    "start": "npm run build && electron .",
    "dev": "concurrently \"npm run build -- --watch\" \"wait-on dist/main/main.js && electron .\"",
    "web": "react-scripts start",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --max-warnings=0",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "package": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react-scripts": "^5.0.1",
    "ts-jest": "^29.1.1",
    "typescript": "^4.9.5",
    "wait-on": "^7.2.0",
    "identity-obj-proxy": "^3.0.0"
  },
  "build": {
    "appId": "com.careconnect.desktop",
    "productName": "CareConnect",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "files": [
      "package.json",
      "dist",
      "build"
    ],
    "extends": null
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  }
}
